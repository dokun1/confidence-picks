# Auth.js session-cookie encryption key. Generate: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth web client. Redirect URI: https://admin.confidence-picks.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The confidence-picks API, and the machine secret shared with its Vercel project
# (ADMIN_API_SECRET must be IDENTICAL on both projects; a mismatch fails closed).
SERVER_API_URL=https://api.confidence-picks.com
ADMIN_API_SECRET=
